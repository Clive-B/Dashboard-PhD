{
  "name": "aic-scholar-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/next/dist/bin/next dev -p 3001",
    "build": "next build",
    "start": "node --use-system-ca ./node_modules/next/dist/bin/next start -p 3001",
    "lint": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:verify": "node scripts/verify-database.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@vercel/oidc": "^4.0.0",
    "bcryptjs": "3.0.2",
    "date-fns": "4.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
