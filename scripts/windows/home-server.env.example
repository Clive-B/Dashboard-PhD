# Copy this file to .local/home-server.env. Never commit the populated file.
AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_EMAIL=replace-with-your-private-email
DEMO_PASSWORD=replace-with-a-unique-password

# Add this after local PostgreSQL is installed and migrated.
# DATABASE_URL=postgresql://aic_scholar_app:encoded-password@127.0.0.1:5432/aic_scholar
DATABASE_REGION=ghana-owner-laptop

GENERAL_AI_ENABLED=false
ALLOW_GOOGLE_SITES_EMBED=false
AIC_GOVERNANCE_MODE=disconnected
