# Development authentication. Change these outside local development.
AUTH_SECRET=replace-with-at-least-32-random-characters
DEMO_EMAIL=clive@example.com
DEMO_PASSWORD=AicScholar!2026

# PostgreSQL 16+ with pgvector. Leave blank to use browser-local First Edition demo data.
# Azure production connections must retain sslmode=verify-full. Never commit the real URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aic_scholar
# This is a deployment declaration, not proof of residency. The verification script
# records it alongside TLS and server checks without exposing credentials.
DATABASE_REGION=local-development

# Optional general-question AI. Academic, planning, Knowledge Vault and work data remain local.
# Vercel deployments obtain a short-lived OIDC token at request time. Set an
# AI Gateway key only for local development or deployments outside Vercel.
GENERAL_AI_ENABLED=true
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Google Sites embedding. Production HTTPS is required when enabled.
ALLOW_GOOGLE_SITES_EMBED=false

# AIC remains disconnected until the custodian supplies an authorized endpoint
# or an approved governance/knowledge package. Do not put tokens in source control.
AIC_GOVERNANCE_MODE=disconnected
AIC_GOVERNANCE_ENDPOINT=
AIC_GOVERNANCE_VERSION=
AIC_AUTHORIZATION_REFERENCE=

# Otter Pro -> Zapier -> AIC Scholar. Generate a long random webhook secret.
# Keep the same value in the deployed environment and Zapier custom header only.
OTTER_ZAPIER_WEBHOOK_SECRET=
OTTER_INGEST_USER_EMAIL=clive@example.com

# Replaceable S3-compatible storage configuration (optional in First Edition).
S3_ENDPOINT=
S3_REGION=af-south-1
S3_BUCKET=aic-scholar
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
